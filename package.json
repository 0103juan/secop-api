{
  "name": "secop-api",
  "version": "1.0.0",
  "private": true,
  "description": "A small, cached, privacy-preserving HTTP API over Colombia's SECOP II public contracts",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "refresh-entities": "node scripts/refresh-entities.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
